{
  "name": "awad-api-contract-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Session 5 starter — the smart-restaurant menu service, and the contract its /v1 API must keep",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "start": "node src/server.js",
    "migrate": "node scripts/migrate.js up",
    "migrate:down": "node scripts/migrate.js down",
    "migrate:status": "node scripts/migrate.js status",
    "seed": "node scripts/seed.js",
    "test": "node --test --test-reporter=spec test/legacy.test.js",
    "contract": "node --test --test-reporter=spec test/contract.test.js"
  }
}
